<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Empaquetado como NuGet para distribucion y reutilizacion entre microservicios -->
    <PackageId>Nuget.Persistence</PackageId>
    <Version>1.0.0</Version>
    <Authors>rodolfo9611</Authors>
    <Description>Biblioteca de clases independiente de persistencia generica, reutilizable por cualquier microservicio a traves de un unico punto de acceso a datos.</Description>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.0" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.4" />
  </ItemGroup>

</Project>